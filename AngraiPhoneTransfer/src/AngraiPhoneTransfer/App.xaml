<Application x:Class="AngraiPhoneTransfer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AngraiPhoneTransfer.Converters"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Angra.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVisibility"/>
            <conv:PresenceToVisibilityConverter x:Key="PresenceToVisibility"/>
            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:KindToIconConverter x:Key="KindToIcon"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
