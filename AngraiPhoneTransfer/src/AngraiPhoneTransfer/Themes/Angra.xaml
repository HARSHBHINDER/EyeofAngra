<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================ Palette ============================
         Same tokens as EyeofAngra on Android: a near-black foundation, two
         elevation steps, warm off-white type, and gold used only for brand,
         selection and the primary action. -->
    <Color x:Key="BackgroundColor">#FF0A0A0C</Color>
    <Color x:Key="SurfaceColor">#FF17181C</Color>
    <Color x:Key="SurfaceAltColor">#FF212228</Color>
    <Color x:Key="GoldColor">#FFD4AF37</Color>

    <SolidColorBrush x:Key="Background" Color="#FF0A0A0C"/>
    <SolidColorBrush x:Key="Surface" Color="#FF17181C"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FF212228"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#FF2A2B32"/>
    <SolidColorBrush x:Key="Divider" Color="#1AF5F2EC"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F2EC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFA8A39A"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#FF5C5952"/>
    <SolidColorBrush x:Key="Gold" Color="#FFD4AF37"/>
    <SolidColorBrush x:Key="GoldMuted" Color="#FF8D713B"/>
    <SolidColorBrush x:Key="GoldSoft" Color="#1FD4AF37"/>
    <SolidColorBrush x:Key="CardBorder" Color="#33D4AF37"/>
    <SolidColorBrush x:Key="Success" Color="#FF42B56A"/>
    <SolidColorBrush x:Key="Warning" Color="#FFE0A030"/>
    <SolidColorBrush x:Key="Danger" Color="#FFC62828"/>
    <SolidColorBrush x:Key="Transparent" Color="Transparent"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <sys:Double x:Key="RadiusSm">12</sys:Double>
    <sys:Double x:Key="RadiusMd">20</sys:Double>

    <!-- ============================= Icons =============================
         Line icons on a 24x24 grid, stroked rather than filled so one set
         works at every size. -->
    <Geometry x:Key="IconEye">M2.5,12 C5.5,7 8.5,5.5 12,5.5 C15.5,5.5 18.5,7 21.5,12 C18.5,17 15.5,18.5 12,18.5 C8.5,18.5 5.5,17 2.5,12 Z M12,9 A3,3 0 1 1 11.99,9 Z</Geometry>
    <Geometry x:Key="IconPhone">M7.5,2.5 L16.5,2.5 L16.5,21.5 L7.5,21.5 Z M10.5,4.6 L13.5,4.6</Geometry>
    <Geometry x:Key="IconFolder">M3.5,6.5 L9,6.5 L11,8.5 L20.5,8.5 L20.5,18.5 L3.5,18.5 Z</Geometry>
    <Geometry x:Key="IconPhoto">M3.5,5.5 L20.5,5.5 L20.5,18.5 L3.5,18.5 Z M3.5,15.5 L8,11 L11.5,14.5 L14.5,11.5 L20.5,17.5 M8.2,9.4 A1.4,1.4 0 1 1 8.19,9.4 Z</Geometry>
    <Geometry x:Key="IconVideo">M3.5,6.5 L14.5,6.5 L14.5,17.5 L3.5,17.5 Z M14.5,10.5 L20.5,7 L20.5,17 L14.5,13.5 Z</Geometry>
    <Geometry x:Key="IconAudio">M9,16.5 A2,2 0 1 1 8.99,16.5 Z M13,16.5 L13,5.5 L18,4 L18,15</Geometry>
    <Geometry x:Key="IconDoc">M7,3.5 L13.5,3.5 L17.5,7.5 L17.5,20.5 L7,20.5 Z M13.5,3.5 L13.5,7.5 L17.5,7.5</Geometry>
    <Geometry x:Key="IconFile">M6.5,3.5 L17.5,3.5 L17.5,20.5 L6.5,20.5 Z M9.5,9 L14.5,9 M9.5,13 L14.5,13</Geometry>
    <Geometry x:Key="IconSearch">M4.5,11 A6.5,6.5 0 1 1 4.49,11 Z M15.7,15.7 L20,20</Geometry>
    <Geometry x:Key="IconRefresh">M20,12 A8,8 0 1 1 17.2,5.9 M20.5,3.5 L20.5,8.5 L15.5,8.5</Geometry>
    <Geometry x:Key="IconCopy">M9,3.5 L19.5,3.5 L19.5,15 M4.5,7.5 L15,7.5 L15,20.5 L4.5,20.5 Z</Geometry>
    <Geometry x:Key="IconMove">M12,3.5 L12,13.5 M8,10 L12,14 L16,10 M4,16.5 L4,20.5 L20,20.5 L20,16.5</Geometry>
    <Geometry x:Key="IconSliders">M4,7.5 L11,7.5 M17,7.5 L20,7.5 M4,16.5 L7,16.5 M13,16.5 L20,16.5 M11,7.5 A3,3 0 1 1 10.99,7.5 Z M7,16.5 A3,3 0 1 1 6.99,16.5 Z</Geometry>
    <Geometry x:Key="IconChevron">M9.5,5.5 L16,12 L9.5,18.5</Geometry>
    <Geometry x:Key="IconCheck">M5,12.5 L9.5,17 L19,6.5</Geometry>
    <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IconMinimise">M6,12 L18,12</Geometry>
    <Geometry x:Key="IconMaximise">M6.5,6.5 L17.5,6.5 L17.5,17.5 L6.5,17.5 Z</Geometry>
    <Geometry x:Key="IconGrid">M4,4 L10.5,4 L10.5,10.5 L4,10.5 Z M13.5,4 L20,4 L20,10.5 L13.5,10.5 Z M4,13.5 L10.5,13.5 L10.5,20 L4,20 Z M13.5,13.5 L20,13.5 L20,20 L13.5,20 Z</Geometry>
    <Geometry x:Key="IconList">M4,6.5 L20,6.5 M4,12 L20,12 M4,17.5 L20,17.5</Geometry>
    <Geometry x:Key="IconWarning">M12,3.5 L21,20 L3,20 Z M12,9.5 L12,14.5 M12,16.8 L12,17.4</Geometry>
    <Geometry x:Key="IconDown">M12,4 L12,18 M6,12.5 L12,18.5 L18,12.5</Geometry>
    <Geometry x:Key="IconUp">M12,20 L12,6 M6,11.5 L12,5.5 L18,11.5</Geometry>
    <Geometry x:Key="IconOpen">M5,5 L11,5 M5,5 L5,19 L19,19 L19,13 M13,11 L20,4 M14.5,4 L20,4 L20,9.5</Geometry>

    <!-- ============================ Typography ============================ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        <Setter Property="Margin" Value="4,0,0,8"/>
    </Style>

    <!-- ============================== Icons =============================== -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TextSecondary}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconPathGold" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{StaticResource Gold}"/>
    </Style>

    <!-- ============================== Cards =============================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="GoldCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="Background" Value="{StaticResource GoldSoft}"/>
    </Style>

    <!-- ============================= Buttons ============================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#FF14130F"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="12" Background="{StaticResource Gold}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFE4C258"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFB9962C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="#33D4AF37"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="12" Background="Transparent"
                            BorderBrush="{StaticResource Divider}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="11" Background="Transparent" Padding="12,10">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="9" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter and option chips -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" CornerRadius="999" Padding="13,6" Background="Transparent"
                            BorderBrush="{StaticResource Divider}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GoldSoft}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- ============================= Text box ============================= -->
    <Style x:Key="AngraTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Gold}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Check box ============================= -->
    <Style x:Key="AngraCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="Transparent" BorderBrush="{StaticResource TextDisabled}" BorderThickness="1.4"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="{StaticResource IconCheck}" Stretch="Uniform"
                                  Width="11" Height="11" Stroke="#FF14130F" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Gold}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== Progress bar =========================== -->
    <Style x:Key="AngraProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="999" Background="#22F5F2EC" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{StaticResource Gold}" RadiusX="3" RadiusY="3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Scroll bar ============================ -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="999" Background="#33F5F2EC" Margin="3,0,3,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
